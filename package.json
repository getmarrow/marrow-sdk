{
  "name": "@getmarrow/sdk",
  "version": "3.7.44",
  "description": "Runtime control, proof, and fleet intelligence for Node.js AI agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:docs && node --test test/*.test.js",
    "test:docs": "tsc --noEmit --target ES2022 --module commonjs --lib ES2022,DOM --strict --esModuleInterop --skipLibCheck --moduleResolution node test/readme-quickstart.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "governance",
    "proof-packs",
    "agent-control-plane",
    "memory",
    "hive",
    "collective-intelligence",
    "LLM",
    "GPT",
    "OpenAI",
    "Claude",
    "autonomous",
    "context",
    "state",
    "persistence",
    "decision",
    "learning",
    "MCP",
    "Model Context Protocol",
    "TypeScript",
    "Node.js",
    "key-management",
    "api-key",
    "multi-key",
    "api-key-management",
    "cli-key-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getmarrow/marrow-sdk.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@getmarrow/sdk": "^2.9.4",
    "@types/node": "^25.5.2",
    "typescript": "^5.3.3"
  }
